# Copy to .env and fill in real values. .env is gitignored AND dockerignored —
# never commit real keys, and never bake them into an image (layers are
# append-only: a key COPY'd in and deleted in a later layer is still recoverable
# by anyone who can pull the image). Compose injects this file at RUN time via
# `env_file`.

# --- LLM (answer generation) ---
# Which provider is active is set in src/config.py (LLMConfig.provider).
# Default config uses DeepSeek (OpenAI-compatible API), so only this is required:
DEEPSEEK_API_KEY=
# To switch LLMConfig.provider to "openai" or "anthropic" later, fill the matching key:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- OpenSearch ---
# Read by src/opensearch_client.py; falls back to IndexConfig.host when unset.
# Leave UNSET for both normal setups:
#   - from source on the host -> http://localhost:9200 (the config default)
#   - docker compose          -> compose sets OPENSEARCH_HOST=http://opensearch:9200,
#     the service NAME. Not localhost: inside a container, localhost means the
#     container itself, so localhost:9200 is a connection refused.
# Set it only to reach a different cluster, e.g. managed AWS OpenSearch:
# OPENSEARCH_HOST=https://my-domain.us-east-1.es.amazonaws.com
#
# The local cluster runs with DISABLE_SECURITY_PLUGIN=true (dev only), so there
# are no credentials to supply. A secured cluster would need them here.
